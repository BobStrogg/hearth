{
  "name": "hearth-acp",
  "version": "0.4.0",
  "description": "Self-hosted daemon + phone-friendly web UI for ACP (Agent Client Protocol) coding agents",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc",
    "start": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "build:sea": "node scripts/build-sea.mjs"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "claude-code",
    "grok",
    "coding-agent",
    "remote"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.9.0",
    "jose": "^6.2.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "jsdom": "^24.1.3",
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "hearth": "dist/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "web",
    "scripts/install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BobStrogg/hearth.git"
  }
}
